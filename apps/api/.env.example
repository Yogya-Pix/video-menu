# Postgres connection string
DATABASE_URL="postgresql://videomenu:videomenu@localhost:5432/videomenu?schema=public"

# Long random string used to sign session JWTs
JWT_SECRET="change-me-to-a-long-random-string"

# Web app origin allowed to call this API with credentials
CORS_ORIGIN="http://localhost:3000"

# Public URL of the web app, used to build the QR code target (defaults to CORS_ORIGIN if unset)
WEB_PUBLIC_URL="http://localhost:3000"

# Port the API listens on
PORT=4000

# AWS S3 (private bucket, accessed only via presigned URLs from this API)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# CloudFront domain in front of the S3 bucket, e.g. d123abc.cloudfront.net
CLOUDFRONT_DOMAIN=""

# Set to "true" in production (Render, etc.) so cookies are sent as SameSite=None; Secure
COOKIE_CROSS_SITE="false"

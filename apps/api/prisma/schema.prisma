generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum VideoStatus {
  PENDING
  READY
  FAILED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoKey     String?
  qrCodeKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  categories Category[]
  menuItems  MenuItem[]
  orders     Order[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String      @id @default(cuid())
  name         String
  description  String?
  priceCents   Int
  isAvailable  Boolean     @default(true)
  sortOrder    Int         @default(0)
  videoKey     String?
  videoStatus  VideoStatus @default(PENDING)
  thumbnailKey String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  tableLabel String?
  notes      String?
  totalCents Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([restaurantId, status])
}

model OrderItem {
  id                 String @id @default(cuid())
  quantity           Int
  nameSnapshot       String
  priceCentsSnapshot Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}
